# MTC Render Backend — copiar como .env para pruebas locales.
PORT=8080
NODE_ENV=development

# URLs permitidas para CORS. En producción agregá tu dominio Netlify y el dominio final.
APP_URL=https://www.moisestradingclub.com
ALLOWED_ORIGINS=http://localhost:5173,https://www.moisestradingclub.com

# Firebase Admin SDK
# Opción recomendada en Render: pegar el service account en base64.
FIREBASE_PROJECT_ID=moises-trading-club
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternativa: JSON literal en una sola línea.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# PayPal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# MetaTrader Auto Sync vía MetaAPI
METAAPI_TOKEN=
METAAPI_DEFAULT_REGION=new-york
ENCRYPTION_KEY=

# Cron externo para endpoints /api/cron/*
# Si queda vacío, el cron queda abierto. En producción usar un valor largo.
CRON_SECRET=
