rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'mentor', 'moderador'];
    }

    // Users can read their profile. They cannot self-edit payment/access fields.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'accessStatus',
          'subscriptionStatus',
          'accessSource',
          'paymentProvider',
          'plan',
          'billingCycle',
          'currentPeriodStart',
          'currentPeriodEnd',
          'startedAt',
          'lastPaymentAt',
          'expiredAt',
          'cancelAtPeriodEnd',
          'approved',
          'status',
          'role'
        ]);
      allow delete: if isAdmin();
    }

    // Payments are created/updated by Cloud Functions/Admin SDK. User only reads own payments.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /paypalWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }


    // Broker Sync connections are created/updated only by Cloud Functions/Admin SDK.
    // Users can read only their own sanitized connection documents; credentials are encrypted server-side.
    match /brokerConnections/{connectionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Existing app collections used by the React app.
    match /trades/{docId} { allow read, write: if signedIn(); }
    match /posts/{docId} { allow read, write: if signedIn(); }
    match /ideas/{docId} { allow read, write: if signedIn(); }
    match /books/{docId} { allow read, write: if signedIn(); }
    match /academyLessons/{docId} { allow read, write: if signedIn(); }
    match /notifications/{docId} { allow read, write: if signedIn(); }
    match /messages/{docId} { allow read, write: if signedIn(); }
    match /resultPosts/{docId} { allow read, write: if signedIn(); }
    match /dailyPlans/{docId} { allow read, write: if signedIn(); }
    match /checklists/{docId} { allow read, write: if signedIn(); }
    match /settings/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
