rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserDoc() && userDoc().data.role in ['admin', 'moderador', 'mentor'];
    }

    function isApproved() {
      return isAdmin() || (hasUserDoc() && (
        userDoc().data.status == 'approved' ||
        userDoc().data.approved == true ||
        userDoc().data.accessStatus in ['active', 'manual_approved'] ||
        userDoc().data.subscriptionStatus == 'active'
      ));
    }

    function protectedAccessFields() {
      return [
        'accessStatus',
        'subscriptionStatus',
        'accessSource',
        'plan',
        'billingCycle',
        'paymentProvider',
        'customerId',
        'subscriptionId',
        'paypalSubscriptionId',
        'startedAt',
        'currentPeriodStart',
        'currentPeriodEnd',
        'cancelAtPeriodEnd',
        'lastPaymentAt',
        'expiredAt',
        'approved',
        'status',
        'role',
        'isAdmin',
        'admin',
        'createdByAdmin',
        'features',
        'limits',
        'trialEndsAt',
        'inviteId'
      ];
    }

    function userCreateIsSafe(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['alumno', 'member', 'invitado']
        && request.resource.data.status in ['pending', 'pending_payment']
        && request.resource.data.approved == false
        && request.resource.data.accessStatus == 'pending_payment'
        && request.resource.data.subscriptionStatus == 'none'
        && request.resource.data.accessSource in ['manual', 'self_signup']
        && (request.resource.data.plan == 'free' || !('plan' in request.resource.data))
        && !request.resource.data.keys().hasAny([
          'customerId',
          'subscriptionId',
          'paypalSubscriptionId',
          'currentPeriodStart',
          'currentPeriodEnd',
          'lastPaymentAt',
          'expiredAt',
          'startedAt',
          'paymentProvider',
          'isAdmin',
          'admin',
          'createdByAdmin'
        ]);
    }

    function userCanUpdateOwnSafeFields(userId) {
      return signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedAccessFields());
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function docUserId(data) {
      return data.userId == request.auth.uid
        || data.uid == request.auth.uid
        || data.ownerId == request.auth.uid;
    }

    function tradeCreateOwnerIsSafe() {
      return docUserId(request.resource.data);
    }

    function tradeResourceOwnerIsSafe() {
      return docUserId(resource.data);
    }

    function ideaOwnerIsSafe() {
      return resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid;
    }

    function ideaCreateOwnerIsSafe() {
      return request.resource.data.authorId == request.auth.uid || request.resource.data.userId == request.auth.uid;
    }

    function ideaLikeUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }

    function postLikeUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }

    function notificationReadUpdateIsSafe() {
      return resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
    }

    match /users/{userId} {
      allow create: if userCreateIsSafe(userId) || isAdmin();
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isApproved());
      allow update: if isAdmin() || userCanUpdateOwnSafeFields(userId);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }


    match /invites/{inviteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /paypalWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /brokerConnections/{connectionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /settings/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if isApproved() && (request.auth.uid == userId || isAdmin());
    }

    match /trades/{tradeId} {
      allow create: if isApproved() && tradeCreateOwnerIsSafe();
      allow read: if isApproved() && (isAdmin() || tradeResourceOwnerIsSafe());
      allow update, delete: if isApproved() && (isAdmin() || tradeResourceOwnerIsSafe());
    }

    match /dailyPlans/{planId} {
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isApproved() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /checklists/{checklistId} {
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow read: if isApproved() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isApproved() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && (isAdmin() || request.resource.data.authorId == request.auth.uid);
      allow update: if isApproved() && (
        isAdmin()
        || resource.data.authorId == request.auth.uid
        || postLikeUpdateIsSafe()
      );
      allow delete: if isApproved() && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    match /ideas/{ideaId} {
      allow read: if isApproved();
      allow create: if isAdmin() || (isApproved() && ideaCreateOwnerIsSafe());
      allow update: if isAdmin() || (isApproved() && (ideaOwnerIsSafe() || ideaLikeUpdateIsSafe()));
      allow delete: if isAdmin() || (isApproved() && ideaOwnerIsSafe());
    }

    match /notifications/{notificationId} {
      allow create: if isApproved() || isAdmin();
      allow read: if isApproved() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isApproved() && notificationReadUpdateIsSafe());
      allow delete: if isAdmin() || (isApproved() && resource.data.userId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow create: if isApproved() && request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if isApproved() && request.auth.uid in resource.data.participants;
    }

    match /books/{bookId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update, delete: if isApproved() && (
        isAdmin()
        || resource.data.authorId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || resource.data.uploaderId == request.auth.uid
      );
    }

    match /academyLessons/{lessonId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /lessonProgress/{progressId} {
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isApproved() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /resultPosts/{resultId} {
      function sensitiveResultFields() {
        return [
          'validationStatus',
          'countsForSeason',
          'featured',
          'mentorReviewResponse',
          'mentorReviewedAt',
          'mentorReviewedBy',
          'mentorDecision',
          'scoreContribution',
          'seasonScore',
          'adminNotes'
        ];
      }
      function isResultAuthor() {
        return resource.data.authorId == request.auth.uid;
      }
      function resultCreateIsSafe() {
        return request.resource.data.authorId == request.auth.uid
          && (!('validationStatus' in request.resource.data) || request.resource.data.validationStatus == 'pending_validation')
          && (!('countsForSeason' in request.resource.data) || request.resource.data.countsForSeason == false)
          && (!('featured' in request.resource.data) || request.resource.data.featured == false)
          && !request.resource.data.keys().hasAny([
            'mentorReviewResponse',
            'mentorReviewedAt',
            'mentorReviewedBy',
            'mentorDecision',
            'scoreContribution',
            'seasonScore',
            'adminNotes'
          ]);
      }
      function authorSafeResultUpdate() {
        return isResultAuthor()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveResultFields())
          && !(resource.data.validationStatus in ['validated', 'featured']);
      }
      allow read: if isApproved();
      allow create: if isApproved() && resultCreateIsSafe();
      allow update: if isApproved() && (isAdmin() || authorSafeResultUpdate());
      allow delete: if isApproved() && (isAdmin() || (isResultAuthor() && !(resource.data.validationStatus in ['validated', 'featured'])));
    }

    match /announcements/{announcementId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
