# Copiá este archivo como .env y pegá tus datos reales de Firebase.
# En Netlify también tenés que cargar estas mismas variables en Environment variables.

VITE_FIREBASE_API_KEY=PEGAR_AQUI
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=PEGAR_AQUI
VITE_FIREBASE_APP_ID=PEGAR_AQUI

# Emails que entran como admin/mentor al registrarse.
# Seguridad: el rol admin debe existir/aprobarse desde backend/Admin SDK o Firebase Console.
VITE_ADMIN_EMAILS=ismaelemeri@gmail.com,mentor@mtc.com

# Backend externo Render/Railway. Vacío en producción si usás proxy Netlify /api/*.
VITE_API_BASE_URL=http://localhost:8080

# Paywall / checkout externo.
VITE_PAYMENTS_ENABLED=true
VITE_PAYMENT_PROVIDER=paypal
VITE_PAYPAL_ENV=sandbox
VITE_PAYPAL_CLIENT_ID=PEGAR_CLIENT_ID_SANDBOX

# Frontend llama solo endpoints backend/Cloud Functions. Nunca poner client secret en React.
VITE_PAYPAL_CREATE_ORDER_ENDPOINT=/api/createPayPalOrder
VITE_PAYPAL_CAPTURE_ORDER_ENDPOINT=/api/capturePayPalOrder
VITE_CHECKOUT_ENDPOINT=/api/createPayPalOrder
VITE_MEMBERSHIP_SYNC_ENDPOINT=/api/updateMembershipStatus
VITE_PAYMENT_SUCCESS_URL=https://www.moisestradingclub.com/payment-success
VITE_PAYMENT_CANCEL_URL=https://www.moisestradingclub.com/payment-cancel
VITE_WHATSAPP_MENTORIA=5493412133662

# Backend Render. Estos valores NO van al frontend público.
PAYPAL_CLIENT_ID=PEGAR_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=PEGAR_CLIENT_SECRET_SANDBOX
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=PEGAR_WEBHOOK_ID_SANDBOX
APP_URL=https://www.moisestradingclub.com

# Producción Netlify: mantener /api/... y configurar netlify.toml hacia Render. Local: usar VITE_API_BASE_URL=http://localhost:8080.

# Broker Sync / MetaTrader Auto Sync
METAAPI_TOKEN=
ENCRYPTION_KEY=
METAAPI_DEFAULT_REGION=new-york
APP_URL=
